# Required: your Discord bot token (https://discord.com/developers/applications)
MATRIMONY_TOKEN=

# Optional configuration (defaults shown)
MATRIMONY_DEFAULT_PREFIX=!
MATRIMONY_COMMAND_NAME=matr
MATRIMONY_DB_PATH=matrimony.db
# 0 = unlimited (matches the original MarriageBot, which has no partner cap)
MATRIMONY_MAX_PARTNERS=0
MATRIMONY_MAX_CHILDREN=0
MATRIMONY_MAX_TREE_DEPTH=10
# Seconds a proposal stays open (buttons + accept/decline commands)
MATRIMONY_PROPOSAL_TTL=300

# Optional per-guild channel allow-list: JSON object mapping guild ids to
# channel id lists. Guilds not listed are unrestricted; a guild mapped to
# [] accepts commands nowhere. Commands in other channels are ignored.
# MATRIMONY_ALLOWED_CHANNELS={"123456789012345678": ["111222333444555666"]}
# Or point to a JSON file with the same structure (inline var wins):
# MATRIMONY_ALLOWED_CHANNELS_FILE=/etc/matrimony/channels.json

# Fluxpoint API token for action GIFs (hug/kiss/slap/...).
# Defaults to the provider's shared public-tier key; set your own token here,
# or leave empty to disable GIFs.
# FLUXPOINT_API_KEY=
